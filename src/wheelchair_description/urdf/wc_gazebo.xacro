<?xml version="1.0"?>
<robot name="wheelchair_description" xmlns:xacro="http://ros.org/wiki/xacro">
  
  <!-- Main Wheels - High friction for traction -->
  <gazebo reference="left_wheel">
    <mu1>10.0</mu1>
    <mu2>10.0</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
    <minDepth>0.01</minDepth>
    <maxVel>10.0</maxVel>
    <fdir1>1 0 0</fdir1>
    <material>Gazebo/Grey</material>
  </gazebo>
  
  <gazebo reference="right_wheel">
    <mu1>10.0</mu1>
    <mu2>10.0</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
    <minDepth>0.01</minDepth>
    <maxVel>10.0</maxVel>
    <fdir1>1 0 0</fdir1>
    <material>Gazebo/Grey</material>
  </gazebo>
  
  <!-- Caster Wheels - Lower friction for free movement -->
  <gazebo reference="l_castor_wheel">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
    <material>Gazebo/Black</material>
  </gazebo>
  
  <gazebo reference="r_castor_wheel">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
    <material>Gazebo/Black</material>
  </gazebo>
  
  <!-- Main wheelchair body -->
  <gazebo reference="wheelchair_main">
    <material>Gazebo/Blue</material>
  </gazebo>
  
  <!-- Caster assemblies -->
  <gazebo reference="left_castor">
    <material>Gazebo/Grey</material>
  </gazebo>
  
  <gazebo reference="right_castor">
    <material>Gazebo/Grey</material>
  </gazebo>
  
  <!-- Encoders -->
  <gazebo reference="left_encoder">
    <material>Gazebo/Black</material>
  </gazebo>
  
  <gazebo reference="right_encoder">
    <material>Gazebo/Black</material>
  </gazebo>
  
  <!-- Sensors -->
  <gazebo reference="lidar">
    <material>Gazebo/Red</material>
  </gazebo>
  
  
  <gazebo reference="camera">
    <material>Gazebo/Black</material>
  </gazebo>
  
  <gazebo reference="IMU">
    <material>Gazebo/Green</material>
  </gazebo>

  
  <!-- Caster axles -->
  <gazebo reference="left_caster_axle">
    <material>Gazebo/Grey</material>
  </gazebo>
  
  <gazebo reference="right_caster_axle">
    <material>Gazebo/Grey</material>
  </gazebo>

  <!-- Differential Drive Plugin - REMOVED to avoid conflict with ros2_control -->
  <!-- Now using unified ros2_control system for both simulation and real hardware -->
  <gazebo>
    <!-- ros2_control will handle differential drive in simulation mode -->
  </gazebo>

  <!-- Camera IMU Plugin - D455 IMU for ros2_control integration -->
  <gazebo reference="IMU">
    <sensor name="camera_imu" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>true</visualize>
      <topic>/imu/out</topic>
      <gz_frame_id>IMU</gz_frame_id>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>


  <!-- LiDAR Plugin (GPU LIDAR) -->
  <gazebo reference="lidar">
    <sensor name="gpu_lidar" type="gpu_lidar">
      <!-- Sim only: the lidar link sits ~4 cm above the floor, so the 0.5-1 deg the chair
           pitches while driving makes the beams hit the floor 3-8 m away (phantom walls in
           the costmap). Lift the sensor 0.25 m; the frame in TF is unchanged and the scan
           is planar, so only the beam height moves. -->
      <pose>0 0 0.25 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <!-- Publish on a fixed topic/frame so the ROS bridge can map it to /scan.
           Without these, gz uses the world-scoped name
           /world/<world>/model/wheelchair/link/lidar/sensor/gpu_lidar/scan
           and frame_ids like wheelchair/lidar/gpu_lidar, which do not exist in TF. -->
      <topic>/scan</topic>
      <gz_frame_id>lidar</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <!-- Sim only: the chair's own right/rear frame blocks -157..-100 deg and
                 164..173 deg (returns at 0.3-1.1 m). Keep the clear arc, -98.5..160.4 deg. -->
            <samples>260</samples>
            <resolution>1</resolution>
            <min_angle>-1.72</min_angle>
            <max_angle>2.80</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.3</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo> 
  
  <!-- ROS 2 Control and Sensor Plugins -->
  <gazebo>
    <!-- ROS 2 Humble - Uses Ignition Gazebo -->
    <xacro:if value="$(arg is_ignition)">
      <plugin filename="ign_ros2_control-system" name="ign_ros2_control::IgnitionROS2ControlPlugin">
        <parameters>$(find wc_control)/config/wc_control.yaml</parameters>
      </plugin>
      <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu">
      </plugin>
      <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
        <render_engine>ogre2</render_engine>
      </plugin>
    </xacro:if>

    <!-- ROS 2 Jazzy and later - Uses Gazebo Sim (gz-sim) -->
    <xacro:unless value="$(arg is_ignition)">
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find wc_control)/config/wc_control.yaml</parameters>
      </plugin>
      <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu">
      </plugin>
      <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
        <render_engine>ogre2</render_engine>
      </plugin>
    </xacro:unless>
  </gazebo>

  <!-- Camera Plugin -->
  <gazebo reference="camera">
    <!-- rgbd_camera publishes camera/image, camera/depth_image and camera/camera_info;
         scripts/voice_nav.py uses the depth to turn a VLM bounding box into a map goal. -->
    <sensor type="rgbd_camera" name="camera1">
      <topic>camera</topic>
      <gz_frame_id>camera_color_optical_frame</gz_frame_id>
      <update_rate>10.0</update_rate>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>15</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>

  <!-- Side RGB-D cameras on the links from urdf/cameras.xacro (left D455, right D435i),
       same names as the RealSense namespaces on the chair. -->
  <xacro:macro name="sim_side_rgbd" params="name">
    <gazebo reference="${name}_link">
      <sensor type="rgbd_camera" name="${name}_sensor">
        <topic>${name}</topic>
        <gz_frame_id>${name}_color_optical_frame</gz_frame_id>
        <update_rate>10.0</update_rate>
        <camera>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>15</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>
  <xacro:sim_side_rgbd name="mapping_camera"/>
  <xacro:sim_side_rgbd name="right_camera"/>

</robot>
